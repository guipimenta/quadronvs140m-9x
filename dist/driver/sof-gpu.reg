REGEDIT4

; sof-gpu.reg: Soldier of Fortune on the GPU (nouveau) OpenGL driver - double-click, no reboot.
; Keeps the GL_EXTENSIONS year cap SoF needs (without it: "SOF caused an invalid page
; fault ... EIP=4c472032") and removes the per-program software override, so sof.exe
; follows the global GALLIUM_DRIVER=nouveau default from nvgl-on.reg / the INF.

[HKEY_LOCAL_MACHINE\Software\vmdisp9x\apps\sof.exe\mesa]
"MESA_EXTENSION_MAX_YEAR"="2000"
"GALLIUM_DRIVER"=-
