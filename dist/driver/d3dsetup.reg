REGEDIT4

; Direct3D helper settings for the Quadro NVS 140M Win98 driver (build 3045).
; Import on an EXISTING install (fresh INF installs write the same keys).
; LP_NATIVE_VECTOR_WIDTH=128: Mesa9x llvmpipe uses SSE vectors (Core 2 has no AVX).

[HKEY_LOCAL_MACHINE\Software\vmdisp9x\apps\global\mesa]
"LP_NATIVE_VECTOR_WIDTH"="128"
