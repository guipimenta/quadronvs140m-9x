# === NVIDIA proprietary material — never commit/redistribute ===
# The original XP driver, the modified 9x package, and anything extracted from
# them stay on disk (needed to build/flash and to reference) but out of git.
/DISPLAY/
/modified_driver/
/analysis/xp_extracted/

# Raw disassembly and binary dumps derived from the proprietary binaries.
# Our *findings* live in the .md/.small-json files, which we do keep.
analysis/reverse/*.asm
analysis/reverse/*.bin
analysis/*.headers.txt
analysis/reverse/NVCORE.VXD.json
analysis/reverse/NVMINI.VXD.json

# === Build intermediates / outputs in the working driver tree ===
# (The shippable binaries under dist/ are kept deliberately.)
driver/vmdisp9x-nv/*.obj
driver/vmdisp9x-nv/*.o
driver/vmdisp9x-nv/*.vxd
driver/vmdisp9x-nv/*.drv
driver/vmdisp9x-nv/*.exe
driver/vmdisp9x-nv/*.res
driver/vmdisp9x-nv/*.lib
driver/vmdisp9x-nv/*.map
driver/vmdisp9x-nv/fixlink.bin
driver/vmdisp9x-nv/res/*.obj
driver/vmdisp9x-nv/res/*.bin
driver/vmdisp9x-nv/vmware/*.obj
driver/build/

# === Misc ===
*.pyc
__pycache__/

# === Third-party material kept on disk only (2026-10-22) ===
/win98se/
/nvidia_old_drivers/
/nvidia_9x_81.98.zip
/*.pdf
# Microsoft 98 DDK binaries/symbols/headers used for the VDD analysis; our
# findings are in analysis/win98_vdd/README.md which IS committed.
/analysis/win98_vdd/*
!/analysis/win98_vdd/README.md

# === Raw captures copied over from the T61 (machine-specific evidence) ===
/BOOTLOG.TXT
/nvlog.txt
/lastset.txt
/nvboot.txt
/evoflip.txt
/evostage.txt
/vramrd.txt
/dir.txt
/commands
/c[0-9].txt
/display.reg
/enum.reg
/nvprobe.txt
