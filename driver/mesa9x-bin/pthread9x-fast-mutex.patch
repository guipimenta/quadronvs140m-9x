+/* Owner = the thread's TIB address (unique per live thread, no KERNEL32 call:
+ * GetCurrentThreadId is an obfuscated lookup on Windows 9x). */
+static inline DWORD mutex_self (void)
+{
+  DWORD t;
+  __asm__ ("movl %%fs:0x18, %0" : "=r" (t));
+  return t;
+}
