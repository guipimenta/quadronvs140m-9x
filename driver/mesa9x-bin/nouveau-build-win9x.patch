 	win9x/svgadrv.c \
 	win9x/svgadrv_cb.c \
 	win9x/svgadrv_present.c
-	
+
+# --- Native nouveau (G86/NV50) driver: nv50 gallium + nv50_ir shader codegen +
+# the Win9x libdrm shim (nvshim.c, which REPLACES libdrm's nouveau.c). The 4
+# video-decode files (VP3/VP2) are excluded - GL does not need them. See the
+# nvidia_reverse repo docs/HW3D_PLAN.md (M5.3c).
+NVDRV = /home/guilherme/projects/nvidia_reverse/driver/vmdisp9x-nv
+MesaNouveauLib_SRC = \
+	$(filter-out %_video.c %_video_bsp.c %_video_vp.c %_video_ppp.c, \
+	  $(wildcard $(MESA_VER)/src/gallium/drivers/nouveau/*.c) \
+	  $(wildcard $(MESA_VER)/src/gallium/drivers/nouveau/nv50/*.c)) \
+	$(wildcard $(MESA_VER)/src/nouveau/codegen/*.cpp) \
+	$(MESA_VER)/src/gallium/winsys/nouveau/drm/nouveau_drm_winsys.c \
+	$(NVDRV)/nvshim.c $(NVDRV)/nvshim_stubs.c
+
 MesaGdiLib_SRC = \
   $(MESA_VER)/src/gallium/winsys/sw/gdi/gdi_sw_winsys.c \
   $(MESA_VER)/src/gallium/winsys/sw/wrapper/wrapper_sw_winsys.c \
diff --git a/mesa-25.1.x/src/gallium/targets/wgl/wgl.c b/mesa-25.1.x/src/gallium/targets/wgl/wgl.c
