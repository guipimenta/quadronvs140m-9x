--- a/mesa-25.1.x/src/gallium/targets/wgl/wgl.c
+++ b/mesa-25.1.x/src/gallium/targets/wgl/wgl.c
@@ -73,6 +73,12 @@ static bool use_d3d12 = false;
 #ifdef GALLIUM_ZINK
 static bool use_zink = false;
 #endif
+#ifdef GALLIUM_NOUVEAU
+/* M5.3c: native nouveau (G86) hardware screen, selected by GALLIUM_DRIVER=nouveau.
+ * nouveau_drm_screen_create ignores the fd and opens the nvmini VxD (nvshim.c). */
+static bool use_nouveau = false;
+extern struct pipe_screen *nouveau_drm_screen_create(int fd);
+#endif
 
 #ifdef WIN9X
 #include "3d_accel.h"
@@ -99,6 +105,13 @@ wgl_screen_create_by_name(HDC hDC, const char* driver, struct sw_winsys *winsys)
 
    debug_printf("tried driver: %s\n", driver);
 
+#ifdef GALLIUM_NOUVEAU
+   if (strcmp(driver, "nouveau") == 0) {
+      screen = nouveau_drm_screen_create(0);   /* fd ignored; opens the VxD */
+      if (screen)
+         use_nouveau = true;
