+				DPIX(draw_x), DPIY(draw_y), win_w - DPIX(draw_x+START_X + HSPACE), DPIY(LINE_HEIGHT),
+				hwnd, (HMENU)0, ((LPCREATESTRUCT)lParam)->hInstance, NULL);
