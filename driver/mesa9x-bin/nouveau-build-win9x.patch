diff --git a/Makefile b/Makefile
index 12b3e391..638cda2c 100644
--- a/Makefile
+++ b/Makefile
@@ -526,7 +526,29 @@ else
 
   endif
 
-  LIBSTATIC = $(AR) rcs -o $@ 
+  LIBSTATIC = $(AR) rcs -o $@
+
+  # Native nouveau driver (M5.3c): its own include set (mesa-compat FIRST, to
+  # shadow the Linux-only uapi headers the driver pulls in) layered on the SIMD
+  # flags so these objects are ABI-compatible with the llvmpipe-built libs they
+  # link beside. A dedicated _nv object suffix keeps this include set off every
+  # other lib (notably mesa-compat/util/os_mman.h must not shadow for them).
+  NV_INCLUDE = -I$(NVDRV)/mesa-compat -I$(MESA_VER)/src/gallium/winsys/nouveau/drm \
+    -I$(MESA_VER)/src/nouveau/headers -I$(MESA_VER)/src/nouveau/codegen \
+    -I$(MESA_VER)/src/nouveau/drm -I$(MESA_VER)/src/gallium/drivers/nouveau
+  # nouveau_screen.c has no MESA_GIT_SHA1 fallback (unlike svga) and mesa9x's
+  # git_sha1.h is empty, so define it here.
+  NV_DEFS     = -DMESA_GIT_SHA1=\"\"
+  NV_CFLAGS   = $(NV_INCLUDE) $(SIMD_CFLAGS) $(NV_DEFS)
+  NV_CXXFLAGS = $(NV_INCLUDE) $(SIMD_CXXFLAGS) $(NV_DEFS)
+
+  %.c_nv$(OBJ): %.c $(DEPS)
+		$(info CC (nv) $@)
+		@$(CC) $(NV_CFLAGS) -c -o $@ $<
+
+  %.cpp_nv$(OBJ): %.cpp $(DEPS)
+		$(info CXX (nv) $@)
+		@$(CXX) $(NV_CXXFLAGS) -c -o $@ $<
 
 endif
 
@@ -631,6 +653,13 @@ $(LIBPREFIX)MesaSVGALibSimd$(LIBSUFFIX): $(MesaSVGALibSimd_OBJS)
 	-$(RM) $@
 	$(LIBSTATIC) $(MesaSVGALibSimd_OBJS)
 
+# Native nouveau (G86) driver lib - M5.3c (see NV_CFLAGS / MesaNouveauLib_SRC)
+MesaNouveauLib_OBJS := $(MesaNouveauLib_SRC:.c=.c_nv$(OBJ))
+MesaNouveauLib_OBJS := $(MesaNouveauLib_OBJS:.cpp=.cpp_nv$(OBJ))
+$(LIBPREFIX)MesaNouveauLib$(LIBSUFFIX): $(MesaNouveauLib_OBJS)
+	-$(RM) $@
+	$(LIBSTATIC) $(MesaNouveauLib_OBJS)
+
 MesaVirGLLib_OBJS := $(MesaVirGLLib_SRC:.c=.c_gen$(OBJ))
 MesaVirGLLib_OBJS := $(MesaVirGLLib_OBJS:.cpp=.cpp_gen$(OBJ))
 $(LIBPREFIX)MesaVirGL$(LIBSUFFIX): $(MesaVirGL_OBJS)
@@ -740,8 +769,13 @@ mesa3d.w95.dll: $(DEPS) $(LIBS_TO_BUILD) $(MesaOS_OBJS) mesa3d.res $(LD_DEPS) fi
 	$(LD) $(LDFLAGS) $(MesaWglLib_OBJS) $(MesaGdiLibICD_OBJS) $(MesaOS_OBJS) $(OPENGL_LIBS) $(MESA_LIBS) mesa3d.res $(DLLFLAGS) $(MESA3D_DEF)
 	$(RUNPATH)fixlink$(HOST_SUFFIX) $(FIXLINK_CMD) $@ $(FIXLINK_PARMS)
 
-mesa3d.w98me.dll: $(DEPS) $(LIBS_TO_BUILD) $(MesaOSSimd_OBJS) mesa3d.res $(LD_DEPS) fixlink.exe
-	$(LD) $(SIMD_LDFLAGS) $(MesaWglLibSimd_OBJS) $(MesaGdiLibICDSimd_OBJS) $(MesaOSSimd_OBJS) $(opengl_simd_LIBS) $(MESA_SIMD_LIBS) mesa3d.res $(DLLFLAGS) $(MESA3D_DEF) 
+# M5.3c: wgl_icd.c (the ICD's screen-create) gets -DGALLIUM_NOUVEAU so it offers
+# the nouveau driver (GALLIUM_DRIVER=nouveau); only this object, so the opengl32
+# and SVGA DLLs that share wgl.c stay software and need not link MesaNouveauLib.
+$(MESA_VER)/src/gallium/targets/wgl/wgl_icd.c_simd$(OBJ): SIMD_CFLAGS += -DGALLIUM_NOUVEAU
+
+mesa3d.w98me.dll: $(DEPS) $(LIBS_TO_BUILD) $(LIBPREFIX)MesaNouveauLib$(LIBSUFFIX) $(MesaOSSimd_OBJS) mesa3d.res $(LD_DEPS) fixlink.exe
+	$(LD) $(SIMD_LDFLAGS) $(MesaWglLibSimd_OBJS) $(MesaGdiLibICDSimd_OBJS) $(MesaOSSimd_OBJS) -Wl,--start-group $(LIBPREFIX)MesaNouveauLib$(LIBSUFFIX) $(opengl_simd_LIBS) -Wl,--end-group $(MESA_SIMD_LIBS) mesa3d.res $(DLLFLAGS) $(MESA3D_DEF)
 	$(RUNPATH)fixlink$(HOST_SUFFIX) $(FIXLINK_CMD) $@ $(FIXLINK_PARMS)
 
 # accelerated ICD driver (SVGA3D) fixlink.exe
diff --git a/mesa-25.1.x.mk b/mesa-25.1.x.mk
