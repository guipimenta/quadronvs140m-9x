+#include "3d_accel.h"
+#include "vramcpy.h"
+
+/* SW headers */
+#if MESA_MAJOR == 21
+# include "pipe/p_format.h"
+# include "pipe/p_context.h"
+#endif
+
+#include "util/u_inlines.h"
+
