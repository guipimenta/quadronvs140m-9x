+LRESULT CALLBACK WndProc(HWND hWnd, UINT message, WPARAM wParam, LPARAM lParam)
+{
+	switch(message)
+	{
+		case WM_CREATE:
+		  //PostQuitMessage(0);
+		break;
+	case WM_DESTROY:
+		PostQuitMessage(0);
+		running = FALSE;
+		break;
+	case WM_TIMER:
+		switch(wParam)
+		{
+			case IDT_TIMER1:
+				timer++;
+				return 0;
+		}	
+		break;
+	case WM_KEYDOWN:
+		if((GetAsyncKeyState(VK_ESCAPE) & 0x0001) ||
+			(GetAsyncKeyState(VK_RETURN) & 0x0001) ||
+			(GetAsyncKeyState(VK_SPACE) & 0x0001))
+		{
+			PostQuitMessage(0);
+			running = FALSE;
+		}
+		break;
+	case WM_SETCURSOR:
+		if(LOWORD(lParam) == HTCLIENT)
+		{
+			SetCursor(NULL);
+			return TRUE;
+		}
+	default:
+		return DefWindowProc(hWnd, message, wParam, lParam);
+	}
+	return 0;
+}
