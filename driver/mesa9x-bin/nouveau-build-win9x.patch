 #ifdef GALLIUM_LLVMPIPE
    if (strcmp(driver, "llvmpipe") == 0) {
 # ifdef HAVE_CRTEX
@@ -237,6 +250,15 @@ wgl_present(struct pipe_screen *screen,
    }
 #endif
 
+#ifdef GALLIUM_NOUVEAU
