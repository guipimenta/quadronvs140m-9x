+/*
+ * Flat shading only changes the result when the vertices of a triangle carry
+ * different colours. When the current DrawPrimitives2 call draws vertices that
+ * all have the same diffuse and specular colour (Half-Life's renderer: all
+ * white), GL_SMOOTH gives exactly the same picture, and it avoids the G86
+ * (nouveau nv50) drawing flat-shaded triangles that the hardware clips with a
+ * garbage colour (Half-Life's white wedges at the screen corners).
+ */
+NUKED_LOCAL void MesaShadeApply(mesa3d_ctx_t *ctx)
+{
+	GLenum mode = (ctx->state.shade_flat && !ctx->state.shade_uniform) ? GL_FLAT : GL_SMOOTH;
+	if(ctx->entry->env.lowdetail >= 3)
+	{
+		mode = GL_FLAT;
+	}
+
+	if(mode != ctx->state.shade_gl)
+	{
+		GL_CHECK(ctx->entry->proc.pglShadeModel(mode));
+		ctx->state.shade_gl = mode;
+	}
+}
