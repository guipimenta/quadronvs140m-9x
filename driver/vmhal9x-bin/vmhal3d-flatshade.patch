+/*
+ * TRUE when every vertex the DP2 command buffer draws has the same diffuse and
+ * specular colour (or the FVF carries no colour at all), so flat and smooth
+ * shading are identical for this call (see MesaShadeApply). Only plain FVF
+ * data with the commands below is examined; anything else answers FALSE and
+ * keeps flat shading as requested. It stops at the first differing colour.
+ */
+NUKED_LOCAL BOOL MesaDraw6ColorsUniform(mesa3d_ctx_t *ctx,
+	LPBYTE cmdBufferStart, LPBYTE cmdBufferEnd, LPBYTE vertices, DWORD fvf, DWORD vertices_max)
+{
+	DWORD stride, off_diffuse = 0, off_specular = 0, n_colors = 0, i, t;
+	DWORD first[2] = {0, 0};
+	BOOL have_first = FALSE;
+	LPBYTE cp;
+
+	if(fvf & 0xFF000000UL)
+		return FALSE; /* not an FVF (DX8+ vertex shader handle) */
+
+	switch(fvf & D3DFVF_POSITION_MASK)
+	{
+		case D3DFVF_XYZ:    stride = 12; break;
+		case D3DFVF_XYZRHW: stride = 16; break;
+		case D3DFVF_XYZB1:  stride = 16; break;
+		case D3DFVF_XYZB2:  stride = 20; break;
+		case D3DFVF_XYZB3:  stride = 24; break;
+		case D3DFVF_XYZB4:  stride = 28; break;
+		case D3DFVF_XYZB5:  stride = 32; break;
+		default:
+			return FALSE;
+	}
+	if(fvf & D3DFVF_NORMAL)   stride += 12;
+	if(fvf & D3DFVF_RESERVED1) stride += 4; /* D3DFVF_PSIZE */
+	if(fvf & D3DFVF_DIFFUSE)  { off_diffuse = stride;  stride += 4; n_colors++; }
+	if(fvf & D3DFVF_SPECULAR) { off_specular = stride; stride += 4; n_colors++; }
+	for(t = 0; t < ((fvf & D3DFVF_TEXCOUNT_MASK) >> D3DFVF_TEXCOUNT_SHIFT); t++)
+	{
+		switch((fvf >> (16 + t*2)) & 3)
+		{
+			case 0: stride += 8;  break; /* D3DFVF_TEXTUREFORMAT2 */
+			case 1: stride += 12; break; /* 3 */
+			case 2: stride += 16; break; /* 4 */
+			default: stride += 4; break; /* 1 */
+		}
+	}
+
+	if(n_colors == 0)
+		return TRUE; /* the default colours are constant */
+
+#define UNIFORM_V(_p) do { \
+		LPBYTE _v = (_p); \
+		DWORD _c[2]; \
+		_c[0] = (fvf & D3DFVF_DIFFUSE)  ? *(DWORD*)(_v + off_diffuse)  : 0; \
+		_c[1] = (fvf & D3DFVF_SPECULAR) ? *(DWORD*)(_v + off_specular) : 0; \
+		if(!have_first) { first[0] = _c[0]; first[1] = _c[1]; have_first = TRUE; } \
+		else if(_c[0] != first[0] || _c[1] != first[1]) return FALSE; \
+	} while(0)
+#define UNIFORM_I(_i) do { \
+		DWORD _ix = (_i); \
+		if(vertices == NULL || _ix >= vertices_max) return FALSE; \
+		UNIFORM_V(vertices + _ix * stride); \
+	} while(0)
+
+	cp = cmdBufferStart;
+	while(cp + 4 <= cmdBufferEnd)
+	{
+		LPD3DHAL_DP2COMMAND c = (LPD3DHAL_DP2COMMAND)cp;
+		LPBYTE p = cp + 4;
+		DWORD cnt = c->wPrimitiveCount;
+		switch(c->bCommand)
+		{
+			case D3DDP2OP_RENDERSTATE:
+			case D3DDP2OP_TEXTURESTAGESTATE:
+			case D3DDP2OP_WINFO:
+			case D3DDP2OP_ZRANGE:
+				p += 8 * cnt;
+				break;
+			case D3DDP2OP_VIEWPORTINFO:
+				p += 16 * cnt;
+				break;
+			case D3DDP2OP_CLEAR:
+				p += 16 + 16 * cnt;
+				break;
+			case D3DDP2OP_POINTS:
+				for(i = 0; i < cnt; i++)
+				{
+					LPD3DHAL_DP2POINTS pt = ((LPD3DHAL_DP2POINTS)p) + i;
+					for(t = 0; t < pt->wCount; t++) UNIFORM_I(pt->wVStart + t);
+				}
+				p += sizeof(D3DHAL_DP2POINTS) * cnt;
+				break;
+			case D3DDP2OP_LINELIST:
+			case D3DDP2OP_LINESTRIP:
+			case D3DDP2OP_TRIANGLELIST:
+			case D3DDP2OP_TRIANGLESTRIP:
+			case D3DDP2OP_TRIANGLEFAN:
+			{
+				DWORD start = ((LPD3DHAL_DP2STARTVERTEX)p)->wVStart, nv;
+				switch(c->bCommand)
+				{
+					case D3DDP2OP_LINELIST:     nv = cnt * 2; break;
+					case D3DDP2OP_LINESTRIP:    nv = cnt + 1; break;
+					case D3DDP2OP_TRIANGLELIST: nv = cnt * 3; break;
+					default:                    nv = cnt + 2; break;
+				}
+				for(t = 0; t < nv; t++) UNIFORM_I(start + t);
+				p += sizeof(D3DHAL_DP2STARTVERTEX);
+				break;
+			}
+			case D3DDP2OP_INDEXEDLINELIST:
+				for(t = 0; t < cnt * 2; t++) UNIFORM_I(((WORD*)p)[t]);
+				p += sizeof(D3DHAL_DP2INDEXEDLINELIST) * cnt;
+				break;
+			case D3DDP2OP_INDEXEDTRIANGLELIST:
+				for(i = 0; i < cnt; i++)
+				{
+					LPD3DHAL_DP2INDEXEDTRIANGLELIST tri = ((LPD3DHAL_DP2INDEXEDTRIANGLELIST)p) + i;
+					UNIFORM_I(tri->wV1); UNIFORM_I(tri->wV2); UNIFORM_I(tri->wV3);
+				}
+				p += sizeof(D3DHAL_DP2INDEXEDTRIANGLELIST) * cnt;
+				break;
+			case D3DDP2OP_INDEXEDLINELIST2:
+			case D3DDP2OP_INDEXEDTRIANGLELIST2:
+			{
+				DWORD base = ((LPD3DHAL_DP2STARTVERTEX)p)->wVStart;
+				DWORD per = (c->bCommand == D3DDP2OP_INDEXEDLINELIST2) ? 2 : 3;
+				WORD *ix = (WORD*)(p + sizeof(D3DHAL_DP2STARTVERTEX));
+				for(t = 0; t < cnt * per; t++) UNIFORM_I(base + ix[t]);
+				p += sizeof(D3DHAL_DP2STARTVERTEX) + cnt * per * sizeof(WORD);
+				break;
+			}
+			case D3DDP2OP_TRIANGLEFAN_IMM:
+			case D3DDP2OP_LINELIST_IMM:
+			{
+				DWORD nv = (c->bCommand == D3DDP2OP_TRIANGLEFAN_IMM) ? cnt + 2 : cnt * 2;
+				if(c->bCommand == D3DDP2OP_TRIANGLEFAN_IMM)
+					p += sizeof(D3DHAL_DP2TRIANGLEFAN_IMM);
+				p = (LPBYTE)((ULONG_PTR)(p + 3) & ~3); /* as MesaDraw6's PRIM_ALIGN */
+				if(p + nv * stride > cmdBufferEnd) return FALSE;
+				for(t = 0; t < nv; t++) UNIFORM_V(p + t * stride);
+				p += nv * stride;
+				break;
+			}
+			default:
+				return FALSE; /* a command this check does not walk */
+		}
+		cp = p;
+	}
+#undef UNIFORM_I
+#undef UNIFORM_V
+	return TRUE;
+}
+
