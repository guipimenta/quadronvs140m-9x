 }
 
+/* Row length (in pixels) of the target surface for GL_(UN)PACK_ROW_LENGTH, 0 when its
+ * rows are packed. Flip-chain surfaces have the screen's pitch, which the display driver
+ * may pad (NV50: 256-byte multiple, 800x600x16 = 1792 bytes, not 1600). */
+static GLint TargetRowLength(mesa3d_ctx_t *ctx)
+{
+	DWORD bp = (ctx->front_bpp + 7) / 8;
+
+	if(ctx->front_pitch == 0 || bp == 0)
+		return 0;
+
+	if(ctx->front_pitch == SurfacePitch(ctx->state.sw, ctx->front_bpp) || (ctx->front_pitch % bp) != 0)
+		return 0;
+
+	return ctx->front_pitch / bp;
+}
+
 NUKED_LOCAL void MesaBufferUploadColor(mesa3d_ctx_t *ctx, const void *src)
 {
 	TRACE_ENTRY
@@ -97,6 +113,12 @@
 
 	GL_CHECK(entry->proc.pglFinish());
 
+	GLint row_length = TargetRowLength(ctx);
+	if(row_length)
+	{
+		GL_CHECK(entry->proc.pglPixelStorei(GL_UNPACK_ROW_LENGTH, row_length));
+	}
+
 	if(ctx->front_bpp == 32)
 	{
 		GL_CHECK(entry->proc.pglActiveTexture(GL_TEXTURE0+ctx->fbo_tmu));
@@ -166,6 +188,11 @@
 		
 		GL_CHECK(entry->proc.pglDisable(GL_TEXTURE_2D));
 	}
+
+	if(row_length)
+	{
+		GL_CHECK(entry->proc.pglPixelStorei(GL_UNPACK_ROW_LENGTH, 0));
+	}
 	
 	if(ctx->fbo_tmu < ctx->tmu_count)
 	{
@@ -211,10 +238,22 @@
 			break;
 	}
 
+	GLint row_length = TargetRowLength(ctx);
+
 	if(front_surface)
 		FBHDA_access_begin(0);
 
+	if(row_length)
+	{
+		GL_CHECK(entry->proc.pglPixelStorei(GL_PACK_ROW_LENGTH, row_length));
+	}
+
 	GL_CHECK(entry->proc.pglReadPixels(0, 0, ctx->state.sw, ctx->state.sh, format, type, dst));
+
+	if(row_length)
+	{
+		GL_CHECK(entry->proc.pglPixelStorei(GL_PACK_ROW_LENGTH, 0));
+	}
 	
 	if(front_surface)
 		FBHDA_access_end(0);
