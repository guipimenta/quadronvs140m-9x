+/* last DDBLT_DEPTHFILL (vmhal9x Blt32 -> hal3d_DepthFill32) */
+static hal3d_depthfill_t depthfill_last;
+static volatile LONG depthfill_seq = 0;
+
+NUKED_LOCAL void MesaDepthFillRecord(const hal3d_depthfill_t *df)
+{
+	depthfill_last = *df;
+	InterlockedIncrement(&depthfill_seq);
+}
+
+/* A z-buffer filled by DirectDraw (DDBLT_DEPTHFILL, e.g. Dungeon Keeper 2 every frame) is
+ * only written in VRAM; GL's depth buffer is separate, so clear it the same way here,
+ * in the context that renders with that z-buffer. */
+static void MesaApplyDepthFill(mesa3d_ctx_t *ctx)
+{
+	LONG seq = depthfill_seq;
+	hal3d_depthfill_t df;
+	void *zptr;
+
+	if(ctx->depthfill_seq == seq)
+		return;
+
+	ctx->depthfill_seq = seq;
+	df = depthfill_last;
+
+	if(ctx->depth == 0 || ctx->depth_bpp == 0)
+		return;
+
+	zptr = MesaGetVidMem(ctx, ctx->depth, MesaOldFlip(ctx));
+	if(zptr == NULL || (DWORD)zptr != df.flat)
+		return;
+
+	TOPIC("DEPTHCONV", "depth fill %X/%X full %d", df.value, df.max, df.full);
+	MesaClear(ctx, D3DCLEAR_ZBUFFER, 0,
+		df.max ? (D3DVALUE)((double)df.value / (double)df.max) : 1.0f, 0,
+		df.full ? 0 : 1, df.full ? NULL : &df.rect);
+}
