+			df.rect.left   = pbd->rDest.left;
+			df.rect.top    = pbd->rDest.top;
+			df.rect.right  = pbd->rDest.right;
+			df.rect.bottom = pbd->rDest.bottom;
+			df.full  = (pbd->rDest.left == 0 && pbd->rDest.top == 0 &&
+				pbd->rDest.right == dwDstWidth && pbd->rDest.bottom == dwDstHeight);
+			D3DDepthFill(&df);
+		}
 		FBHDA_DD_surface_modify((void*)dst->fpVidMem);
 #endif
 	}
