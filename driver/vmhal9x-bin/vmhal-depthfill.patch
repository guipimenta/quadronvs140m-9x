+			hal3d_depthfill_t df;
+			DWORD zmask = 0;
+			if(dstx->dwFlags & DDRAWISURF_HASPIXELFORMAT)
+			{
+				zmask = dst->ddpfSurface.dwZBitMask;
+			}
+			if(zmask == 0)
+			{
+				zmask = (bpp >= 32) ? 0xFFFFFFFFUL : ((1UL << bpp) - 1);
