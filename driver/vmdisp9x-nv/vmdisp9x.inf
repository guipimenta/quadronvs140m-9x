;
; INF file for VirtualBox VGA  Win9x display driver
;              VirtualBox SVGA Win9x display driver
;              VMWare SVGA-II  Win9x display driver
;              QEMU STD        Win9x display driver
;              VESA VBE 2.0+   Win9x display driver
;              QEMU QXL        Win9x display driver (in progress)
; Copyright 2012-2022, The OS/2 Museum
;           2023-2026, Jaroslav Hensl

[version]
DriverVer=01/01/2026,4.2026.0.0
Class=DISPLAY
signature="$CHICAGO$"
Provider=%Mfg%

[DestinationDirs]
DefaultDestDir=11 ; LDID_SYS
VBox.Copy=11
VMSvga.Copy=11
DX.Copy=11
Voodoo.Copy=11
VESA.Copy=11
Qemu.Copy=11
NV.Copy=11

[SourceDisksNames]
; BOXV9X is the driver disk volume label
1="VMDisp9x Display Driver for Win9x Disk",,0

[SourceDisksFiles]
boxvmini.drv=1
boxvmini.vxd=1
vmwsmini.drv=1
vmwsmini.vxd=1
qemumini.drv=1
qemumini.vxd=1
qxlmini.drv=1
qxlmini.vxd=1
vesamini.drv=1
vesamini.vxd=1
nvmini.drv=1
nvmini.vxd=1
vmhal9x.dll=1
vmdisp9x.dll=1
vmhal3d.dll=1
mesa3d.dll=1
;mesa:mesa3d.dll=1
;mesa:mesasmp.dll=1
;mesa:vmwsgl32.dll=1
;openglide:glide2x.dll=1
;openglide:glide3x.dll=1
;wined3d:wined3d.dll=1
;wined3d:winedd.dll=1
;wined3d:wined8.dll=1
;wined3d:wined9.dll=1
;switcher:tray3d.exe=1
;switcher:vesamode.exe=1
;3dfx:3dfxSpl2.dll=1,3dfx
;3dfx:3dfxSpl3.dll=1,3dfx
;3dfx:3dfxVGL.dll=1,3dfx
;nine:mesa89.dll=1
;nine:mesa99.dll=1
;vmhal:vmhal9x.dll=1
;vmhal486:vmhal486.dll=1
;vmhal:vmdisp9x.dll=1
;vmhal:vmhal3d.dll=1

[Manufacturer]
%Mfg%=Mfg.VM

[Mfg.VM]
%VBoxVideoVGA.DeviceDesc%=VBox, PCI\VEN_80EE&DEV_BEEF&SUBSYS_00000000
%VBoxVideoSVGA.DeviceDesc%=VBoxSvga, PCI\VEN_80EE&DEV_BEEF&SUBSYS_040515AD
%VBoxVideoVM2.DeviceDesc%=VMSvga, PCI\VEN_15AD&DEV_0405&SUBSYS_040515AD
;svga3:%VBoxVideoVM3.DeviceDesc%=VMSvga, PCI\VEN_15AD&DEV_0406&SUBSYS_040615AD
%QemuStd.DeviceDesc%=Qemu, PCI\VEN_1234&DEV_1111
;qxl;%QemuQXL.DeviceDesc%=QXL, PCI\VEN_1B36&DEV_0100
%NVG86T61.DeviceDesc%=NV, PCI\VEN_10DE&DEV_0429&SUBSYS_20D817AA
%NVS140M.DeviceDesc%=NV, PCI\VEN_10DE&DEV_0429
; M4.2: the T61 runs the adapter on the root VGA devnode (ROOT\*PNP0900); let
; the INF bind there too so a plain Have Disk install needs no tricks.
%NVG86ROOT.DeviceDesc%=NV, *PNP0900
%VESAPCI.DeviceDesc%=VESA, PCI\CC_0300
%VESAISA.DeviceDesc%=VESA, *PNP0900

[VBox]
CopyFiles=VBox.Copy,Dx.Copy,Voodoo.Copy
DelReg=VM.DelReg
AddReg=VBox.AddReg,VM.AddReg,DX.addReg,VM.regextra

[Qemu]
CopyFiles=Qemu.Copy,Dx.Copy,Voodoo.Copy
DelReg=VM.DelReg
AddReg=Qemu.AddReg,VM.AddReg,DX.addReg,VM.regextra

[QXL]
CopyFiles=QXL.Copy,Dx.Copy,Voodoo.Copy
DelReg=VM.DelReg
AddReg=QXL.AddReg,VM.AddReg,DX.addReg,VM.regextra

[VBoxSvga]
CopyFiles=VMSvga.Copy,Dx.Copy,Voodoo.Copy
DelReg=VM.DelReg
AddReg=VMSvga.AddReg,VM.AddReg,DX.addReg,VM.regextra

[VMSvga]
CopyFiles=VMSvga.Copy,Dx.Copy,Voodoo.Copy
DelReg=VM.DelReg
AddReg=VMSvga.AddReg,VM.AddReg,DX.addReg,VM.regextra

[VESA]
CopyFiles=VESA.Copy,Dx.Copy,Voodoo.Copy
DelReg=VM.DelReg
AddReg=VESA.AddReg,VM.AddReg,DX.addReg,VM.regextra

; NVIDIA G86 (Quadro NVS 140M). Scans out through the VESA backend for now,
; plus native hardware detection (Milestone 2). Reuses VM.AddReg mode list.
[NV]
CopyFiles=NV.Copy,Dx.Copy,Voodoo.Copy
DelReg=VM.DelReg
; VM.AddReg first so that the NV-specific DEFAULT values (DDC=0 in particular)
; override the shared ones (VM.AddReg writes DDC=1).
AddReg=VM.AddReg,NV.AddReg,DX.addReg,VM.regextra

[NV.Copy]
nvmini.drv,,,0x00000004
nvmini.vxd,,,0x00000004
; DirectDraw HAL (JHRobotics/vmhal9x, MIT; built from commit 8bc480e, API 20260213)
vmhal9x.dll,,,0x00000004
vmdisp9x.dll,,,0x00000004
vmhal3d.dll,,,0x00000004
; Mesa9x software OpenGL (llvmpipe), used by vmhal3d.dll for Direct3D (3045)
mesa3d.dll,,,0x00000004

[NV.AddReg]
HKR,DEFAULT,drv,,nvmini.drv
HKR,DEFAULT,minivdd,,nvmini.vxd
HKR,DEFAULT,Mode,,"16,1024,768"
; DDC=0 tells the Win98 VDD monitor enumerator (_VDDEnumMonitor) NOT to read
; the EDID itself via INT 10h AX=4F15 in V86 mode: on the G86 that V86 VBIOS
; call crawls for ~3 minutes at every boot (BOOTLOG: "Enumerating NVIDIA ..."
; -> "Enumerated" = 173 s). A Default Monitor is created immediately instead.
HKR,DEFAULT,DDC,,0
; Native G86 modeset on (the VxD default since 3033 too; set 0 to force the
; vga.drv fallback boot). Same string convention as VRAMLimit below.
HKLM,Software\vmdisp9x\vesa,Native,,1
; Mesa9x runtime settings (read by mesa3d.dll): 128-bit vectors = SSE, the
; right choice for the T61's Core 2 (no AVX).
HKLM,Software\vmdisp9x\apps\global\mesa,LP_NATIVE_VECTOR_WIDTH,,128
; 3110: hardware OpenGL (Mesa's nv50 driver on the G86 through nvmini.vxd) for every
; program; per-program opt-out = GALLIUM_DRIVER=llvmpipe in apps\<exe>\mesa (nvgl-off.reg
; removes the global value). mesa3d.dll falls back to software if the GPU screen fails.
HKLM,Software\vmdisp9x\apps\global\mesa,GALLIUM_DRIVER,,"nouveau"
HKLM,Software\vmdisp9x\apps\hl.exe\mesa,MESA_EXTENSION_MAX_YEAR,,2000
; OpenGL ICD (3046+): opengl32.dll asks the display driver (OPENGL_GETINFO
; escape) for an ICD name, nvmini.drv answers "SOFTWARE", and this key maps it
; to mesa3d.dll. Only valid with the mesa3d.dll built against this driver's
; FBHDA API (20260213) - see driver/mesa9x-bin/PROVENANCE.txt.
HKLM,Software\Microsoft\Windows\CurrentVersion\OpenGLdrivers,SOFTWARE,2,"mesa3d.dll"

