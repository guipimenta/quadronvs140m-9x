REGEDIT4

; Direct3D / OpenGL helper settings for the Quadro NVS 140M Win98 driver (3046).
; Import on an EXISTING install (fresh INF installs write the same keys).
; LP_NATIVE_VECTOR_WIDTH=128: Mesa9x llvmpipe uses SSE vectors (Core 2 has no AVX).
; OpenGLdrivers\SOFTWARE: the OpenGL ICD name nvmini.drv reports -> mesa3d.dll
; (needs the mesa3d.dll from build 3046 or later; older ones misread FBHDA).

[HKEY_LOCAL_MACHINE\Software\vmdisp9x\apps\global\mesa]
"LP_NATIVE_VECTOR_WIDTH"="128"

; GL_EXTENSIONS year cap: since 3113 mesa3d.dll defaults MESA_EXTENSION_MAX_YEAR to 2000 itself
; (Half-Life, Soldier of Fortune and other 1998-2001 engines copy the list into a fixed buffer),
; so no per-game key is needed; a program that wants the later extensions sets its own value
; under apps\<exe>\mesa, e.g. "MESA_EXTENSION_MAX_YEAR"="9999".

; GPU compatibility list (3114, same as the INF): EMPTY since 3115 (GART). The 3114 entry
; kept Soldier of Fortune on software OpenGL; it is confirmed on the GPU now, so importing
; this file on a machine that got the 3114 key removes it (sof.exe follows the GPU default).
[HKEY_LOCAL_MACHINE\Software\vmdisp9x\apps\sof.exe\mesa]
"GALLIUM_DRIVER"=-

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\OpenGLdrivers]
"SOFTWARE"="mesa3d.dll"
